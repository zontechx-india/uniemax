# ===========================================================================
# Environment configuration — template. Copy the relevant blocks into real
# files; none of the real ones are in git.
#
#   .env               shared values, identical in every environment
#   .env.development   your laptop   (the default — nothing to set)
#   .env.production    the EC2 box   (selected by APP_ENV=production)
#
# src/config/loadEnv.ts resolves the mode and layers the files:
#
#   mode = APP_ENV ?? NODE_ENV ?? "development"
#   .env.<mode>  wins  →  .env  fills the gaps
#
# You never edit a file to switch environments. To point a local run at the
# production database for a one-off:
#
#   PowerShell:  $env:APP_ENV="production"; npm run dev
#   bash:        APP_ENV=production npm run dev
#
# On the server, pm2 supplies APP_ENV=production via ecosystem.config.cjs.
#
# INVARIANT: every key belongs to EITHER .env OR a per-mode file, never both.
# ===========================================================================


# ---------------------------------------------------------------------------
# .env — SHARED
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

JWT_SECRET=                      # >= 32 chars in production
JWT_ADMIN_EXPIRES_IN=1d
JWT_CUSTOMER_EXPIRES_IN=30d

OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_BYPASS=false                 # true is rejected in production

RESEND_API_KEY=
EMAIL_FROM=
MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_AUTH_TOKEN=
SMS_COUNTRY_CODE=91

STORAGE_DRIVER=s3                # production refuses "local"
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=               # empty on EC2 → instance IAM role
AWS_SECRET_ACCESS_KEY=
STORAGE_LOGO_BUCKET=
STORAGE_MEDIA_BUCKET=
STORAGE_LOGO_PREFIX=store_logo
STORAGE_MEDIA_PREFIX=product_media
STORAGE_LOGO_PUBLIC_URL=
STORAGE_MEDIA_PUBLIC_URL=
STORAGE_LOCAL_DIR=uploads

MEDIA_MAX_IMAGE_MB=5
MEDIA_MAX_VIDEO_MB=50
MEDIA_MAX_LOGO_MB=2
MEDIA_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/avif
MEDIA_VIDEO_TYPES=video/mp4,video/webm,video/quicktime

# Platform support contact — shown on the seller's Help & Support page.
# All three have live defaults; set them only to override.
# SUPPORT_EMAIL=support@uniemax.com
# SUPPORT_PHONE=+91 7708774542
# SUPPORT_HOURS=Mon–Sat, 10 AM – 7 PM IST

CASHFREE_APP_ID=                 # must be set together with the secret
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production          # sandbox | production
CASHFREE_API_VERSION=2023-08-01

VAPID_SUBJECT=mailto:you@example.com


# ---------------------------------------------------------------------------
# .env.development — YOUR LAPTOP
# ---------------------------------------------------------------------------
# NODE_ENV=development
#
# DATABASE_URL="postgresql://postgres.<dev-ref>:<pw>@aws-N-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<dev-ref>:<pw>@aws-N-<region>.pooler.supabase.com:5432/postgres"
#
# PUBLIC_WEB_URL=http://localhost:5173
# PUBLIC_API_URL and CORS_ORIGIN intentionally unset here.
#
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY — a LOCAL pair (npm run push-keys).


# ---------------------------------------------------------------------------
# .env.production — THE SERVER
# ---------------------------------------------------------------------------
# NODE_ENV=production
#
# DATABASE_URL="postgresql://postgres.<prod-ref>:<pw>@aws-N-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<prod-ref>:<pw>@aws-N-<region>.pooler.supabase.com:5432/postgres"
#
# CORS_ORIGIN=https://your-domain,https://www.your-domain     # "*" is rejected
# PUBLIC_WEB_URL=https://your-domain
# PUBLIC_API_URL=https://your-domain
#
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY — the SERVER'S pair, generated on the
# box. Overwriting it invalidates every browser push subscription, so keep the
# server's values in this file and it can never be clobbered by an upload.

# Connection-string gotchas (both environments):
#   - Use the poolers: :6543 transaction (runtime), :5432 session (migrations).
#   - Never db.<ref>.supabase.co — IPv6-only, unreachable from IPv4 hosts.
#   - Percent-encode "@" in the password as %40.
#   - The aws-N- prefix differs per project; copy it from Supabase → Connect.
