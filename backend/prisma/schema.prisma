// White-label e-commerce platform — core data model (Phase 1)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  /// Platform-processed payment (gateway; dev builds simulate it).
  ONLINE
  COD
  UPI
  RAZORPAY
  CARD
  NETBANKING
}

/// How the customer receives the order — mirrors the store's shipping mode.
enum OrderFulfilment {
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShippingType {
  FIXED
  DISTRICT
  STATE
  FREE
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  LOGIN // phone OTP sign-in
  LINK // linking a second identifier to an existing account
  EMAIL_VERIFY // verifying a customer's email address
  PASSWORD_RESET // forgot-password reset code
  ORDER_PLACEMENT // guest checkout verification
}

/// Social sign-in providers supported by `package/auth`. Adding a provider
/// (e.g. APPLE going live) is one enum value + one verifier implementation.
enum AuthProvider {
  GOOGLE
  APPLE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

/// Who a push subscription / notification belongs to. Mirrors
/// `AuthSession.principalType` — deliberately a plain string union rather than
/// a foreign key, so the notification subsystem stays domain-agnostic.
enum PrincipalType {
  ADMIN
  CUSTOMER
}

/// Notification category — drives the icon/label in the client and lets a
/// recipient filter their feed. Adding a kind is one enum value.
enum NotificationKind {
  ORDER_PLACED
  ORDER_STATUS
  PAYMENT
  STORE
  ACCOUNT
  ANNOUNCEMENT
  SUPPORT
}

// ---------------------------------------------------------------------------
// White-label store configuration (single row)
// Branding / contact / defaults that let one codebase serve any business.
// ---------------------------------------------------------------------------

model StoreSetting {
  id                String   @id @default(cuid())
  businessName      String
  businessType      String   @default("General")
  logoUrl           String?
  about             String?
  contactEmail      String?
  contactPhone      String?
  address           String?
  socialLinks       Json? // { instagram, facebook, whatsapp, ... }
  currency          String   @default("INR")
  // Order-independent shipping default; per-rule config lives in ShippingRule.
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("store_settings")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  imageUrl     String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  // Self-relation enables arbitrary category trees (Sports > Cricket Bat)
  // without code changes — core to the white-label requirement.
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  sku               String         @unique
  brand             String?
  description       String?
  price             Decimal        @db.Decimal(10, 2)
  discountPrice     Decimal?       @db.Decimal(10, 2)
  stockQuantity     Int            @default(0)
  // Overrides StoreSetting.lowStockThreshold when set.
  lowStockThreshold Int?
  // Flexible per-product spec map so any product type works without schema
  // changes: { "Weight": "1.2kg", "Willow": "English", ... }
  specifications    Json?
  status            ProductStatus  @default(ACTIVE)
  isFeatured        Boolean        @default(false)
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images            ProductImage[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  isCover      Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Customers & Orders (guest checkout — account not mandatory)
// ---------------------------------------------------------------------------

model Customer {
  id String @id @default(cuid())

  // A customer is identified by email and/or phone. At least one is present
  // (enforced by the auth service); each is unique to a single account, so an
  // email/phone maps to exactly one customer. Email is verified via a
  // verification code (or trusted from an OAuth provider); phone via OTP.
  email           String?   @unique
  phone           String?   @unique
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // Set when the customer registers with (or later adds) a password.
  // Null for social-only / OTP-only accounts.
  passwordHash String?

  name      String?
  avatarUrl String? // usually populated from an OAuth profile picture
  altPhone  String? // secondary contact number, not a login identifier

  /// Set when a platform admin blocks the account. A blocked customer cannot
  /// sign in (every strategy checks it) and all their sessions are revoked at
  /// block time, so existing tokens die with the next refresh. Nullable
  /// timestamp rather than a boolean: "when" is what an audit needs.
  blockedAt     DateTime?
  blockedReason String?

  oauthAccounts  OAuthAccount[]
  orders         Order[]
  stores         Store[]
  addresses      CustomerAddress[]
  supportTickets SupportTicket[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("customers")
}

/// A saved delivery address in the customer's address book (a customer can
/// keep several; service caps at 10). Exactly one is `isPrimary` — the
/// default suggestion at checkout. The fields cover everything a store's
/// checkout can ask for (see Store.checkout); `email` stays optional since
/// not every store collects it.
model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Optional label shown in the list — "Home", "Work"…
  label       String?
  name        String
  phone       String
  email       String?
  addressLine String
  pincode     String
  state       String
  country     String  @default("India")

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("customer_addresses")
}

/// A customer-owned online store (a single account can own several).
/// Creation is intentionally minimal (name; logo optional — upload arrives
/// with S3). `theme` holds the Appearance settings as JSON so the
/// customization feature can evolve without migrations. `slug` is the
/// store's public URL identity (auto-generated, stable across renames);
/// `isPublished` gates the public storefront page — unpublished stores are
/// never served to customers.
model Store {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  /// Storage OBJECT KEY of the uploaded logo (e.g. "store-logo/…/x.webp") —
  /// never a full URL. The public URL is derived from configuration at read
  /// time, so buckets/CDNs/providers can change without touching rows.
  logoKey     String?
  theme       Json? // { backgroundColor, primaryColor, secondaryColor?, surfaceColor?, buttonTextColor? }
  /// Which storefront homepage sections the owner shows.
  /// { hero, categories, featured, newArrivals, bestSellers } — all default
  /// true. JSON like `theme` so new sections (offers, banners, reviews…) can
  /// be added without a migration.
  homepage    Json?
  /// Owner-managed storefront footer content: business locations (with
  /// optional map coordinates), social profiles, store info (about, GST…),
  /// customer support, policy links, custom links and copyright text.
  /// JSON like `theme`/`homepage` so footer sections can evolve without a
  /// migration; validated + normalised by `stores.schema.ts#resolveFooter`.
  footer      Json?
  /// Payment acceptance switches: { acceptOnlinePayment, acceptCod }.
  /// Defaults (via `resolvePayments`): COD on, online off. JSON so future
  /// methods (UPI-only, partial payment…) slot in without a migration.
  payments    Json?
  /// Shipping/fulfilment settings: { mode: DELIVERY | PICKUP | BOTH }
  /// (default DELIVERY via `resolveShipping`). JSON so the shipping-charge
  /// rules (fixed/district/state) can join the column without a migration.
  shipping    Json?
  /// Which customer fields this store's checkout collects:
  /// { name, phone, email, address, pincode, state, country } — booleans,
  /// all default TRUE via `resolveCheckoutFields`. A disabled field is
  /// hidden from the customer and excluded from checkout validation.
  checkout    Json?
  isPublished Boolean   @default(false)
  /// Set the FIRST time the store is published (never reset), so marketplace
  /// "New Stores" ranks by real publish time — re-publishing an old store
  /// doesn't bump it back to the top.
  publishedAt DateTime?

  /// Set when a platform admin suspends the store. A suspended store is
  /// removed from the public storefront and marketplace and refuses new
  /// orders, while the owner keeps managing it (so they can fix whatever
  /// caused the suspension). Independent of `isPublished`: lifting a
  /// suspension restores whatever the owner had chosen.
  suspendedAt     DateTime?
  suspendedReason String?

  ownerId String
  owner   Customer @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  categories     StoreCategory[]
  products       StoreProduct[]
  bankAccounts   StoreBankAccount[]
  orders         Order[]
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([isPublished])
  // Marketplace "New Stores" listing: published stores by publish recency.
  @@index([isPublished, publishedAt])
  @@map("stores")
}

/// A category inside a customer-owned store (separate from the admin's
/// global Category tree). Products require a category, so owners must
/// create a category before they can add products — the enforced setup
/// sequence. One optional level of nesting: a root category can hold
/// subcategories (`parentId`), and a subcategory cannot have children —
/// Store → Category → Subcategory → Product (service-enforced).
model StoreCategory {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Optional parent — null for root categories. Deleting a category with
  // subcategories is a 409 (Restrict), mirroring the products guard.
  parentId String?
  parent   StoreCategory?  @relation("StoreCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children StoreCategory[] @relation("StoreCategoryTree")

  name       String
  /// URL identity within the store — the storefront addresses a category as
  /// /store/{storeSlug}/category/{slug}. Generated from the name on create
  /// and deliberately STABLE across renames, so shared links keep working
  /// (same convention as Store.slug).
  slug       String
  // Disabled categories (and everything inside them, subcategories
  // included) are hidden from the public storefront but stay manageable —
  // the store-catalog analogue of the store-level publish switch.
  isActive   Boolean        @default(true)
  /// Surfaces this root category in the storefront homepage's
  /// "Featured Categories" row. Owner-controlled merchandising.
  isFeatured Boolean        @default(false)
  products   StoreProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentId])
  @@index([isActive])
  @@map("store_categories")
}

/// A product inside a customer-owned store. Category is mandatory
/// (Restrict — deleting a category with products is a 409, mirroring the
/// admin catalog's delete guard). Images arrive with the S3 integration.
model StoreProduct {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String
  category   StoreCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  /// URL identity within the store — /store/{storeSlug}/product/{slug}.
  /// Generated on create, stable across renames.
  slug        String
  description String?
  // Price and stock live on the VARIANTS, never here — the variant is the
  // unit of sale. A product with no options still has exactly one variant
  // (flagged `isDefault`), so there is always precisely one place a price
  // can come from.
  //
  // Disabled products are hidden from the public storefront (a product is
  // publicly visible only when it AND its category are active).
  isActive    Boolean @default(true)

  /// Owner-controlled merchandising. Each flag maps to exactly ONE storefront
  /// homepage section and nothing else — a product appears in a section if and
  /// only if its flag is set, so the checkboxes mean literally what they say.
  /// `hideFromSearch` is unrelated to the homepage: it removes the product from
  /// search results while leaving it browsable in its category.
  isFeatured     Boolean @default(false)
  isBestSeller   Boolean @default(false)
  isNewArrival   Boolean @default(false)
  hideFromSearch Boolean @default(false)

  /// DENORMALISED aggregates over the product's **sellable** variants (active
  /// only), maintained by `recomputeProductAggregates()` on every variant
  /// mutation. Price lives on the variant, so without these columns the
  /// storefront could not sort or filter by price in SQL — it would have to
  /// load every product into memory, defeating pagination. `priceMin` is null
  /// when nothing is sellable, which is exactly the "hide from storefront"
  /// condition.
  priceMin   Decimal? @db.Decimal(10, 2)
  priceMax   Decimal? @db.Decimal(10, 2)
  stockTotal Int      @default(0)

  variants   StoreProductVariant[]
  media      StoreProductMedia[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
  @@index([isActive])
  @@index([priceMin])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@index([isNewArrival])
  @@map("store_products")
}

/// A purchasable variation of a store product — one label covers whatever
/// axes the product needs ("Red", "XL", "128 GB", "Red / 128 GB"). This is
/// the **unit of sale**: price and stock live here, never on the product, so
/// every product owns at least one variant (an option-less product carries a
/// single implicit one flagged `isDefault`).
model StoreProductVariant {
  id        String       @id @default(cuid())
  productId String
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  name          String
  // Required: every variant carries its own price (no inheriting a base).
  price         Decimal @db.Decimal(10, 2)
  stockQuantity Int     @default(0)
  // Disabled variants are hidden from the public storefront.
  isActive      Boolean @default(true)
  // The implicit single variant of a product that has no options. It is
  // hidden from the storefront's variant picker and is replaced the moment
  // the owner adds a real, named variant.
  isDefault     Boolean @default(false)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@map("store_product_variants")
}

enum StoreMediaType {
  IMAGE
  VIDEO
}

/// Verification state of a seller payout account. Accounts start PENDING;
/// verification will be performed by a third-party provider (penny-drop /
/// account validation API) and can also be done manually by a UnieMax admin
/// from the future admin panel. Editing a verified account's details resets
/// it to PENDING.
enum BankVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

/// How a payout account was (or will be) verified — provisioned now, wired
/// when the third-party integration and the admin panel land.
enum BankVerificationMethod {
  THIRD_PARTY
  MANUAL
}

/// A seller's payout bank account (a store can save several). Exactly ONE
/// may be primary — that account alone receives payouts from UnieMax when
/// customers pay through the platform. Verification fields are provisioned
/// ahead of the integrations: `verificationRef` stores the third-party
/// provider's check id, `verifiedBy` the admin who manually verified
/// (future admin panel), `verificationNote` a failure reason / admin note.
model StoreBankAccount {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  accountHolderName String
  accountNumber     String
  ifsc              String
  bankName          String
  branch            String
  upiId             String?

  /// The payout target. At most one per store (service-enforced).
  isPrimary Boolean @default(false)

  verificationStatus BankVerificationStatus  @default(PENDING)
  verificationMethod BankVerificationMethod?
  verificationRef    String?
  verificationNote   String?
  verifiedAt         DateTime?
  verifiedBy         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The same account can't be added to one store twice.
  @@unique([storeId, accountNumber, ifsc])
  @@index([storeId])
  @@map("store_bank_accounts")
}

/// Media attached to a store product — up to 8 images and 1 video
/// (service-enforced). Stores only the storage OBJECT KEY (e.g.
/// "products/{storeId}/{productId}/x.webp"), never a URL: the public URL is
/// derived from configuration at read time, so the bucket, CDN, AWS account
/// or storage provider can change without touching a single row.
/// The image with the lowest `displayOrder` is the product's COVER image.
model StoreProductMedia {
  id        String       @id @default(cuid())
  productId String
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  type         StoreMediaType
  key          String
  /// Optional alternative text for accessibility (images only in practice).
  altText      String?
  displayOrder Int            @default(0)

  createdAt DateTime @default(now())

  @@index([productId, displayOrder])
  @@map("store_product_media")
}

/// A social-login identity linked to a customer (one row per provider account).
/// `(provider, providerAccountId)` is the stable key OAuth providers guarantee
/// (Google/Apple `sub` claim) — email on the provider side can change.
model OAuthAccount {
  id                String       @id @default(cuid())
  provider          AuthProvider
  providerAccountId String // the provider's stable user id (`sub`)
  email             String? // provider-side email at link time (snapshot)
  customerId        String
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@unique([provider, providerAccountId])
  @@index([customerId])
  @@map("oauth_accounts")
}

/// A customer order, placed PER STORE at the storefront checkout. Everything
/// the order needs is snapshotted (store name/slug, contact + delivery
/// details, item names/prices), so history survives store or product edits
/// and deletions. Contact/delivery fields are nullable because the SELLER
/// chooses which checkout fields to collect (Store.checkout).
model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  // The store the order belongs to — SetNull + snapshots below so the
  // seller deleting their store never erases a customer's order history.
  storeId   String?
  store     Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeName String
  storeSlug String

  // Optional link to a Customer (guest checkout keeps it null).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  fulfilment OrderFulfilment @default(DELIVERY)

  // Contact + delivery snapshot (captured at checkout; per-store fields).
  customerName  String?
  customerPhone String?
  customerEmail String?
  addressLine   String?
  pincode       String?
  state         String?
  country       String?

  // Money (all snapshots at time of order)
  subtotal       Decimal @db.Decimal(10, 2)
  shippingCharge Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  paymentMethod    PaymentMethod @default(COD)
  paymentStatus    PaymentStatus @default(PENDING)
  /// Gateway payment reference — "DEV-SIMULATED" for development-mode
  /// online payments; the Cashfree cf_payment_id once a real payment lands.
  paymentRef       String?
  /// The order_id registered with Cashfree for the LATEST payment attempt —
  /// orderNumber for the first attempt, "orderNumber~R<n>" for retries after
  /// an expired session. Null for COD / simulated orders.
  cfOrderId        String?       @unique
  /// Cashfree payment_session_id of the latest attempt (drives the web SDK
  /// checkout). Useless once paymentStatus is PAID.
  paymentSessionId String?

  // Seller order-management lifecycle stamps — set when the seller moves the
  // order along PENDING → CONFIRMED → PACKED → SHIPPED → DELIVERED (forward
  // jumps are allowed, e.g. PACKED → DELIVERED for pickup orders — a skipped
  // stage simply keeps a null stamp) or cancels it.
  confirmedAt  DateTime?
  packedAt     DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  /// Optional seller note captured on cancellation.
  cancelReason String?

  estimatedDeliveryAt DateTime?
  placedAt            DateTime    @default(now())
  items               OrderItem[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([storeId])
  @@index([customerId])
  @@index([customerPhone])
  @@index([status])
  @@map("orders")
}

/// One line of an order. Product/variant links are nullable + snapshotted so
/// historical orders survive catalog edits and deletions. `imageKey` is the
/// cover image's storage key at order time (URL derived at read).
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   StoreProduct?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   StoreProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  /// Chosen option label ("Red / 128 GB") — null for simple products.
  variantName String?
  productSlug String?
  imageKey    String?
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Shipping configuration (calculated automatically at checkout)
// ---------------------------------------------------------------------------

model ShippingRule {
  id             String       @id @default(cuid())
  type           ShippingType
  // Region name for DISTRICT/STATE rules; null for FIXED/FREE.
  region         String?
  amount         Decimal      @default(0) @db.Decimal(10, 2)
  // For FREE rules: order subtotal at/above which shipping is waived.
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  // Lower number = evaluated first (more specific rules win).
  priority       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("shipping_rules")
}

// ---------------------------------------------------------------------------
// OTP verification (order placement + order-history access)
// ---------------------------------------------------------------------------

model Otp {
  id          String     @id @default(cuid())
  channel     OtpChannel
  destination String // email address or phone number the code was sent to
  // Locally-generated codes (EMAIL): a hash of the code, never the plaintext.
  codeHash    String?
  // Provider-managed codes (SMS via Message Central): the provider's
  // verification id — the code itself never touches our servers.
  providerRef String?
  purpose     OtpPurpose
  // Set for LINK requests — the account the identifier is being linked to.
  customerId  String?
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([destination, purpose])
  @@index([expiresAt])
  @@map("otps")
}

// ---------------------------------------------------------------------------
// Home banners (carousel)
// ---------------------------------------------------------------------------

model Banner {
  id           String   @id @default(cuid())
  title        String?
  imageUrl     String
  linkUrl      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@map("banners")
}

// ---------------------------------------------------------------------------
// Admin users (multiple admins ready; roles for future granularity)
// ---------------------------------------------------------------------------

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admins")
}

/// Refresh-token session issued by the standalone `package/auth` module.
/// Domain-agnostic on purpose: it stores only an opaque principal
/// (`principalId` + `principalType`), never a foreign key, so the package
/// stays reusable across projects. Rotated on each refresh; `replacedById`
/// links the chain so a reused (already-rotated) token flags a breach.
model AuthSession {
  id            String    @id @default(cuid())
  principalId   String
  principalType String // "admin" | "customer"
  role          String? // snapshot (e.g. admin role) for fast re-issue
  refreshHash   String    @unique // sha256 of the opaque refresh token
  userAgent     String?
  ip            String?
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String? // id of the session that rotated this one
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())

  @@index([principalId, principalType])
  @@map("auth_sessions")
}

// ---------------------------------------------------------------------------
// Notifications & Web Push
// ---------------------------------------------------------------------------

/// A browser Web Push subscription (W3C Push API). One row per device/browser
/// per principal — the same person on a phone and a laptop has two.
/// `endpoint` is the push service's URL and is globally unique, which is what
/// makes re-subscribing idempotent: the browser hands back the same endpoint,
/// so we upsert instead of accumulating dead rows.
///
/// Keys are the subscription's own public material (`p256dh`) and auth secret
/// — required to encrypt a payload for that device. They are NOT credentials
/// of ours; the sender's identity is the VAPID key pair (see package/push).
model PushSubscription {
  id            String        @id @default(cuid())
  principalId   String
  principalType PrincipalType

  endpoint String @unique
  p256dh   String
  auth     String

  userAgent String?

  /// Set when the push service permanently rejected the endpoint (404/410 —
  /// the browser dropped the subscription). Kept rather than deleted so a
  /// device that stops receiving can be explained; excluded from every send.
  disabledAt   DateTime?
  /// Consecutive transient send failures — reset on success.
  failureCount Int       @default(0)

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([principalId, principalType])
  @@index([disabledAt])
  @@map("push_subscriptions")
}

/// A delivered notification, kept so the recipient has a feed (bell menu)
/// independent of whether a push actually reached a device. Domain-agnostic
/// like AuthSession: an opaque principal, never a foreign key.
///
/// `url` is an in-app path the client navigates to on click ("/orders/abc").
/// `data` holds the small payload a client may want without a second fetch.
model Notification {
  id            String        @id @default(cuid())
  principalId   String
  principalType PrincipalType

  kind  NotificationKind
  title String
  body  String
  url   String?
  data  Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  // The feed query: this principal's rows, newest first.
  @@index([principalType, principalId, createdAt])
  @@index([principalType, principalId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Admin audit trail
// ---------------------------------------------------------------------------

/// An append-only record of every state-changing action a platform admin
/// takes (suspend a store, block a customer, verify a payout account…).
/// Write-once by design — nothing in the app updates or deletes a row — so it
/// stays trustworthy for incident review. `meta` carries the action's own
/// details (previous value, reason, affected counts).
model AdminAuditLog {
  id         String @id @default(cuid())
  adminId    String
  /// Snapshot of the actor's email — an admin can be deleted, the trail can't.
  adminEmail String

  /// Dotted action name, e.g. "store.suspend" / "customer.block".
  action     String
  entityType String
  entityId   String
  meta       Json?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ---------------------------------------------------------------------------
// Support tickets
// Sellers (and any customer) raising an issue with the UnieMax platform team.
// ---------------------------------------------------------------------------

/// Who answers a support ticket. This is the axis `storeId` cannot express:
/// a seller writing to UnieMax *about* their store and a shopper writing *to*
/// that store both name the same store, and only this column separates them.
enum SupportRecipient {
  /// The UnieMax platform team answers (shoppers and sellers alike).
  PLATFORM
  /// The store's owner answers — a shopper contacting the shop they bought
  /// from. UnieMax is not a party to these threads.
  STORE
}

/// Lifecycle of a support ticket. Forward-only in practice, except that a
/// customer reply on a RESOLVED ticket reopens it — "resolved" is the
/// platform's opinion, and the person who raised it gets to disagree.
/// CLOSED is terminal: nobody can post to a closed ticket.
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// What the ticket is about — chosen by the person raising it, so the queue
/// can be triaged before anything is read. Adding a subject is one value.
enum SupportTicketCategory {
  ORDERS
  PAYMENTS
  PAYOUTS
  PRODUCTS
  STORE_SETUP
  /// Shopper reporting a store/seller to the platform. Never offered to a
  /// seller writing about their own store.
  STORE_REPORT
  ACCOUNT
  TECHNICAL
  OTHER
}

/// Triage level, set by the platform team only. Deliberately NOT customer
/// input: given the choice everyone picks URGENT and the field stops sorting
/// anything.
enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// A support request raised from the app. Owned by the Customer who raised it
/// (cascade delete); `storeId` is set when it was raised from a store's
/// management pages, which is how the admin sees which business is affected —
/// SetNull with a `storeName` snapshot, so a deleted store never takes the
/// conversation with it.
///
/// `contactEmail` / `contactPhone` are snapshots of how to reach the reporter
/// at the time they wrote in — an account's email can change, and a ticket
/// must stay answerable by the details the reporter actually gave.
model SupportTicket {
  id           String @id @default(cuid())
  /// Human-quotable reference ("TKT-M4X7-9QRS"), unique, shown in both apps.
  ticketNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  storeId   String?
  store     Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  /// Snapshot — the ticket keeps naming the store after the store is gone.
  storeName String?

  /// Who answers. PLATFORM tickets belong to the admin console's queue;
  /// STORE tickets belong to the store owner and never appear there.
  recipient SupportRecipient @default(PLATFORM)

  subject  String
  category SupportTicketCategory @default(OTHER)
  status   SupportTicketStatus   @default(OPEN)
  /// Triage level. Only ever set by the platform team, so it stays NORMAL on
  /// STORE tickets — a seller's queue is small enough to read.
  priority SupportTicketPriority @default(NORMAL)

  contactEmail String?
  contactPhone String?

  /// Bumped by every message on either side, so the queue can sort by "who is
  /// waiting longest" without joining the message table.
  lastMessageAt DateTime  @default(now())
  resolvedAt    DateTime?
  closedAt      DateTime?

  messages  SupportTicketMessage[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  // The reporter's own list, newest activity first.
  @@index([customerId, lastMessageAt])
  // The admin queue: PLATFORM only, filtered by status, sorted by activity.
  @@index([recipient, status, lastMessageAt])
  // A seller's inbox: one store's incoming threads, newest activity first.
  @@index([storeId, recipient, lastMessageAt])
  @@map("support_tickets")
}

/// One message in a ticket thread. `authorType` reuses `PrincipalType`
/// (ADMIN / CUSTOMER) — the same principal vocabulary as sessions and
/// notifications — with `authorName` snapshotted so the thread still reads
/// correctly after an admin account is removed.
model SupportTicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorType PrincipalType
  /// Customer id or admin id. Opaque, like every other principal reference.
  authorId   String
  /// Snapshot of the author's display name at write time.
  authorName String?

  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}
