// Dropshipping — sellers bring their own suppliers, who ship straight to the
// seller's customers. Lives in its own Postgres schema and never relates to a
// core model: every core id is a plain string, so the package can move to a
// standalone service. Design and status: docs/dropshipping/.

enum SupplierStatus {
  PENDING // only when inviteNeedsAdminApproval
  ACTIVE
  SUSPENDED

  @@schema("dropship")
}

enum SupplierVisibility {
  PRIVATE
  PUBLIC // public catalogue, Phase 7

  @@schema("dropship")
}

enum InviteStatus {
  SENT
  ACCEPTED
  REVOKED
  EXPIRED

  @@schema("dropship")
}

enum LinkStatus {
  /// A supplier joined with an account that does not match the invite; the seller must approve (D-51).
  PENDING
  ACTIVE
  PAUSED
  ENDED

  @@schema("dropship")
}

/// Who pays the supplier's shipping fee when a parcel comes back (D-17).
enum ReturnFeePayer {
  SELLER
  SUPPLIER

  @@schema("dropship")
}

enum DropshipActor {
  SUPPLIER
  SELLER
  ADMIN
  SYSTEM

  @@schema("dropship")
}

/// A store that ships orders for the sellers it is linked to.
model Supplier {
  id             String             @id @default(cuid())
  /// The supplier's store (core `stores.id`).
  storeId        String             @unique
  /// True when the store was created on joining (D-28): its storefront
  /// set-up steps are hidden.
  supplyOnly     Boolean            @default(false)
  status         SupplierStatus     @default(ACTIVE)
  visibility     SupplierVisibility @default(PRIVATE)
  /// Charged per supplier order.
  shippingFee    Decimal            @default(0) @db.Decimal(10, 2)
  /// Asked when joining, never pre-selected.
  shipWithinDays Int
  /// 0 = no returns. Asked when joining, never pre-selected.
  returnDays     Int
  /// Admin's note on suspend / restore.
  statusNote     String?
  links          SupplierLink[]
  products       SupplyProduct[]
  orders         SupplierOrder[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
  @@map("suppliers")
  @@schema("dropship")
}

/// A one-time link a seller sends to bring a supplier.
model SupplierInvite {
  id             String         @id @default(cuid())
  /// sha-256 of the link token; the token itself is never stored.
  tokenHash      String         @unique
  sellerStoreId  String
  /// Customer id of the seller who sent it.
  createdBy      String
  contactName    String
  contactPhone   String?
  contactEmail   String?
  codAllowed     Boolean
  returnFeePayer ReturnFeePayer
  status         InviteStatus   @default(SENT)
  expiresAt      DateTime
  /// Set on accept.
  linkId         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([sellerStoreId, status])
  @@map("supplier_invites")
  @@schema("dropship")
}

/// One seller–supplier relationship.
model SupplierLink {
  id             String          @id @default(cuid())
  supplierId     String
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sellerStoreId  String
  /// Current terms; every order keeps its own copy (D-18).
  codAllowed     Boolean
  returnFeePayer ReturnFeePayer
  status         LinkStatus      @default(ACTIVE)
  /// Who paused or ended it (either side, D-19).
  statusBy       DropshipActor?
  resales        Resale[]
  orders         SupplierOrder[]
  settlements    Settlement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([supplierId, sellerStoreId])
  @@index([sellerStoreId, status])
  @@map("supplier_links")
  @@schema("dropship")
}

/// A supplier's own product offered to its sellers.
model SupplyProduct {
  id         String          @id @default(cuid())
  supplierId String
  supplier   Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  /// The supplier's own StoreProduct (never a copy).
  productId  String          @unique
  isOpen     Boolean         @default(true)
  variants   SupplyVariant[]
  resales    Resale[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([supplierId, isOpen])
  @@map("supply_products")
  @@schema("dropship")
}

model SupplyVariant {
  id              String        @id @default(cuid())
  supplyProductId String
  supplyProduct   SupplyProduct @relation(fields: [supplyProductId], references: [id], onDelete: Cascade)
  /// The supplier's StoreProductVariant.
  variantId       String        @unique
  /// "Price for sellers".
  cost            Decimal       @db.Decimal(10, 2)
  isOpen          Boolean       @default(true)

  @@index([supplyProductId])
  @@map("supply_variants")
  @@schema("dropship")
}

/// Every change to a term, shown to both sides and kept for disputes (D-18).
/// A change takes effect for orders placed after createdAt.
model TermsChange {
  id         String        @id @default(cuid())
  supplierId String
  /// null = a supplier-wide term (fee, ship within, returns, price).
  linkId     String?
  /// "shippingFee" · "shipWithinDays" · "returnDays" · "cost:{variantId}" ·
  /// "codAllowed" · "returnFeePayer"
  field      String
  fromValue  String?
  toValue    String?
  /// Customer or admin id.
  changedBy  String
  changedAs  DropshipActor
  createdAt  DateTime      @default(now())

  @@index([supplierId, createdAt])
  @@index([linkId, createdAt])
  @@map("terms_changes")
  @@schema("dropship")
}

enum ResaleState {
  ACTIVE
  PAUSED

  @@schema("dropship")
}

enum PauseReason {
  COST_ABOVE_PRICE
  SUPPLY_CLOSED
  SUPPLIER_INACTIVE
  LINK_INACTIVE
  SOURCE_REMOVED

  @@schema("dropship")
}

/// A seller's copy of a supply product: a real StoreProduct in the seller's
/// store (D-9), kept in sync with the supplier's by services/resale.ts (sync).
model Resale {
  id              String          @id @default(cuid())
  sellerStoreId   String
  linkId          String
  link            SupplierLink    @relation(fields: [linkId], references: [id], onDelete: Restrict)
  /// The copy (the seller's StoreProduct).
  productId       String          @unique
  supplyProductId String
  supplyProduct   SupplyProduct   @relation(fields: [supplyProductId], references: [id], onDelete: Restrict)
  /// D-12: the price follows the supplier's price so earnings stay the same.
  followCost      Boolean         @default(true)
  state           ResaleState     @default(ACTIVE)
  pauseReason     PauseReason?
  /// The copy was live when the system paused it; only then does it go back on (C-15).
  resumeOnClear   Boolean         @default(false)
  variants        ResaleVariant[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([sellerStoreId, supplyProductId])
  @@index([linkId])
  @@index([supplyProductId])
  @@map("resales")
  @@schema("dropship")
}

model ResaleVariant {
  id              String  @id @default(cuid())
  resaleId        String
  resale          Resale  @relation(fields: [resaleId], references: [id], onDelete: Cascade)
  /// The copy's variant.
  variantId       String  @unique
  /// The supplier's StoreProductVariant it mirrors.
  supplyVariantId String
  /// Cost already applied to the price; makes follow-price idempotent (C-21).
  lastCost        Decimal @db.Decimal(10, 2)

  @@index([resaleId])
  @@index([supplyVariantId])
  @@map("resale_variants")
  @@schema("dropship")
}

// ---------------------------------------------------------------------------
// Phase 4: supplier orders (docs/dropshipping/data-model/orders)
// ---------------------------------------------------------------------------

enum SupplierOrderStatus {
  AWAITING_PAYMENT
  EXPIRED
  NEW
  ACCEPTED
  SHIPPED
  DELIVERED
  REJECTED
  CANCELLED
  RETURNED

  @@schema("dropship")
}

enum PaymentMode {
  PREPAID
  COD

  @@schema("dropship")
}

enum StatementState {
  PENDING
  OWED
  HELD
  VOID
  SPLIT

  @@schema("dropship")
}

enum SplitState {
  REQUESTED
  DONE
  FAILED
  FALLBACK_DIRECT

  @@schema("dropship")
}

/// D-16: how the supplier is paid. DIRECT until Easy Split (Phase 6).
enum SettleVia {
  DIRECT
  SPLIT

  @@schema("dropship")
}

/// One supplier's share of one customer order. Every term is a snapshot taken
/// inside the placement transaction (D-18); nothing later reads the current settings.
model SupplierOrder {
  id              String              @id @default(cuid())
  /// The customer order (core `orders.id`).
  orderId         String
  orderNumber     String
  sellerStoreId   String
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  linkId          String
  link            SupplierLink        @relation(fields: [linkId], references: [id], onDelete: Restrict)
  status          SupplierOrderStatus @default(AWAITING_PAYMENT)
  paymentMode     PaymentMode
  /// COD only: the order total (COD orders are always one parcel, D-13).
  collectAmount   Decimal?            @db.Decimal(10, 2)
  shipWithinDays  Int
  returnDays      Int
  returnFeePayer  ReturnFeePayer
  platformFee     Decimal             @default(0) @db.Decimal(10, 2)
  /// May only fall back SPLIT → DIRECT (T-10).
  settleVia       SettleVia
  shipBy          DateTime?
  /// The core OrderShipment once shipped.
  shipmentId      String?
  /// Why REJECTED / CANCELLED / EXPIRED / RETURNED.
  closeReason     String?
  /// "Report a problem" (F-9).
  issueOpenAt     DateTime?
  issueTicketId   String?
  /// Admin's Needs action → Resolve.
  adminResolvedAt DateTime?
  adminNote       String?
  /// Hourly-job reminders, one each (D-41): the supplier was nudged to confirm,
  /// the seller was told it is late, the supplier was nudged to mark it delivered.
  confirmRemindedAt   DateTime?
  lateNotifiedAt      DateTime?
  deliveredRemindedAt DateTime?
  /// When the customer's payment landed (prepaid): the split waits a couple of minutes after it.
  paidAt          DateTime?
  /// Easy Split (Phase 6, D-46): one request per customer order, key split:{orderId}.
  splitState      SplitState?
  /// The provider's reference for the split.
  splitRef        String?
  splitAt         DateTime?
  splitAttempts   Int                 @default(0)
  splitError      String?
  /// A COD order's platform fee debited from the seller's vendor (once), or why it couldn't be.
  feeAdjustedAt   DateTime?
  feeAdjustError  String?
  costTotal       Decimal             @db.Decimal(10, 2)
  shippingFee     Decimal             @db.Decimal(10, 2)
  /// costTotal + shippingFee.
  supplierShare   Decimal             @db.Decimal(10, 2)
  statementState  StatementState      @default(PENDING)
  owedAt          DateTime?
  acceptedAt      DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  closedAt        DateTime?
  lines           SupplierOrderLine[]
  events          SupplierOrderEvent[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([orderId, supplierId])
  @@index([supplierId, status])
  @@index([sellerStoreId, createdAt])
  @@index([linkId, statementState])
  @@index([status, createdAt])
  @@index([status, shipBy])
  @@map("supplier_orders")
  @@schema("dropship")
}

model SupplierOrderLine {
  id                String        @id @default(cuid())
  supplierOrderId   String
  supplierOrder     SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  /// The customer order line (core `order_items.id`).
  orderItemId       String        @unique
  /// The supplier's StoreProductVariant: the stock reserved and released.
  supplierVariantId String
  productName       String
  variantName       String?
  /// The SUPPLIER's SKU, for its packing slip.
  supplierSku       String?
  quantity          Int
  /// Snapshot at placement.
  unitCost          Decimal       @db.Decimal(10, 2)

  @@index([supplierOrderId])
  @@index([supplierVariantId])
  @@map("supplier_order_lines")
  @@schema("dropship")
}

/// Audit trail of every status change.
model SupplierOrderEvent {
  id              String               @id @default(cuid())
  supplierOrderId String
  supplierOrder   SupplierOrder        @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  from            SupplierOrderStatus?
  to              SupplierOrderStatus
  actor           DropshipActor
  actorId         String?
  note            String?
  createdAt       DateTime             @default(now())

  @@index([supplierOrderId, createdAt])
  @@map("supplier_order_events")
  @@schema("dropship")
}

// ---------------------------------------------------------------------------
// Phase 5: recorded payments (docs/dropshipping/data-model/money)
// ---------------------------------------------------------------------------

enum SettlementDirection {
  SELLER_TO_SUPPLIER
  SUPPLIER_TO_SELLER

  @@schema("dropship")
}

/// A payment one side recorded as made to the other (D-16, DIRECT lines). The
/// statement counts it until its recorder deletes it; the row is kept for audit.
model Settlement {
  id         String              @id @default(cuid())
  linkId     String
  link       SupplierLink        @relation(fields: [linkId], references: [id], onDelete: Restrict)
  direction  SettlementDirection
  amount     Decimal             @db.Decimal(10, 2)
  paidOn     DateTime
  /// UPI or bank reference.
  reference  String?
  note       String?
  /// The customer who recorded it.
  recordedBy String
  /// SELLER or SUPPLIER.
  recordedAs DropshipActor
  deletedAt  DateTime?
  createdAt  DateTime            @default(now())

  @@index([linkId, paidOn])
  @@map("settlements")
  @@schema("dropship")
}

// ---------------------------------------------------------------------------
// Phase 6: the sandbox payout provider (D-44). Written only by the sandbox host;
// the real provider (PaymentHub) never touches it. No money moves.
// ---------------------------------------------------------------------------

enum SandboxLedgerKind {
  SPLIT
  ADJUSTMENT

  @@schema("dropship")
}

model SandboxLedger {
  id        String            @id @default(cuid())
  /// Idempotency: the same key answers with the same row.
  key       String            @unique
  kind      SandboxLedgerKind
  /// The customer order (a split) — null for an adjustment.
  orderId   String?
  /// The store debited or credited (an adjustment).
  storeId   String?
  amount    Decimal?          @db.Decimal(10, 2)
  /// A split: the entries as requested; an adjustment: its direction.
  payload   Json
  createdAt DateTime          @default(now())

  @@index([orderId])
  @@map("sandbox_ledger")
  @@schema("dropship")
}
